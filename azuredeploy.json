{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "SOC Buddy ARM Template",
      "version": "1.0.0"
    },
    "description": "Deploys all Azure resources for SOC Buddy: Azure AI Foundry (Cognitive Services), Azure Container Registry, Log Analytics, Container Apps Environment, User-Assigned Managed Identity, RBAC Role Assignments, and Azure Container App."
  },
  "parameters": {
    "appName": {
      "type": "string",
      "metadata": {
        "description": "The base name for the application and associated resources."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources."
      }
    },
    "blueprintClientId": {
      "type": "string",
      "metadata": {
        "description": "The Application (Client) ID of the Agent 365 Blueprint."
      }
    },
    "agenticInstanceId": {
      "type": "string",
      "metadata": {
        "description": "The Agent Instance ID / Agentic Instance ID from Agent 365."
      }
    },
    "tenantId": {
      "type": "string",
      "defaultValue": "[subscription().tenantId]",
      "metadata": {
        "description": "The Microsoft Entra Tenant ID."
      }
    },
    "teamsBotClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The Application (Client) ID of the Teams Bot App Registration."
      }
    },
    "foundryModelName": {
      "type": "string",
      "defaultValue": "gpt-5.6-luna",
      "metadata": {
        "description": "Model deployment name in Azure AI Foundry / Cognitive Services."
      }
    },
    "foundryModelVersion": {
      "type": "string",
      "defaultValue": "2026-07-09",
      "metadata": {
        "description": "Model version for the model deployment."
      }
    },
    "initialContainerImage": {
      "type": "string",
      "defaultValue": "mcr.microsoft.com/k8se/quickstart:latest",
      "metadata": {
        "description": "Initial container image to deploy. The deployment script updates this to the ACR image once built."
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[uniqueString(resourceGroup().id)]",
    "cleanAppName": "[take(replace(replace(toLower(parameters('appName')), '-', ''), '_', ''), 16)]",
    "uamiName": "[format('uami-{0}', parameters('appName'))]",
    "acrName": "[take(format('acr{0}{1}', variables('cleanAppName'), variables('uniqueSuffix')), 48)]",
    "logAnalyticsName": "[format('log-{0}', parameters('appName'))]",
    "caeName": "[format('cae-{0}', parameters('appName'))]",
    "foundryAccountName": "[take(format('foundry-{0}-{1}', variables('cleanAppName'), variables('uniqueSuffix')), 60)]",
    "cognitiveServicesUserRoleId": "a97b65f3-24c7-4388-baec-2e87135dc908",
    "acrPullRoleId": "7f951dda-4ed3-4680-a7ca-43fe172d538d"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('uamiName')]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[variables('acrName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "adminUserEnabled": false
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('logAnalyticsName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[variables('caeName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
      ],
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName')), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName')), '2023-09-01').primarySharedKey]"
          }
        }
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2024-10-01",
      "name": "[variables('foundryAccountName')]",
      "location": "[parameters('location')]",
      "kind": "AIServices",
      "sku": {
        "name": "S0"
      },
      "properties": {
        "customSubDomainName": "[variables('foundryAccountName')]",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-10-01",
      "name": "[format('{0}/{1}', variables('foundryAccountName'), parameters('foundryModelName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName'))]"
      ],
      "sku": {
        "name": "GlobalStandard",
        "capacity": 50
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[parameters('foundryModelName')]",
          "version": "[parameters('foundryModelVersion')]"
        },
        "versionUpgradeOption": "OnceNewDefaultVersionAvailable"
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/providers/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[format('{0}/Microsoft.Authorization/{1}', variables('foundryAccountName'), guid(resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName')), variables('uamiName'), variables('cognitiveServicesUserRoleId')))]",
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uamiName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('cognitiveServicesUserRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uamiName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.ContainerRegistry/registries/providers/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[format('{0}/Microsoft.Authorization/{1}', variables('acrName'), guid(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), variables('uamiName'), variables('acrPullRoleId')))]",
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uamiName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('acrPullRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uamiName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uamiName'))]": {}
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('caeName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uamiName'))]",
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName'))]",
        "[resourceId('Microsoft.ContainerRegistry/registries/providers/roleAssignments', variables('acrName'), 'Microsoft.Authorization', guid(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), variables('uamiName'), variables('acrPullRoleId')))]",
        "[resourceId('Microsoft.CognitiveServices/accounts/providers/roleAssignments', variables('foundryAccountName'), 'Microsoft.Authorization', guid(resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName')), variables('uamiName'), variables('cognitiveServicesUserRoleId')))]"
      ],
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('caeName'))]",
        "configuration": {
          "registries": [
            {
              "server": "[format('{0}.azurecr.io', variables('acrName'))]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uamiName'))]"
            }
          ],
          "ingress": {
            "external": true,
            "targetPort": 3978,
            "allowInsecure": false,
            "transport": "auto"
          }
        },
        "template": {
          "containers": [
            {
              "name": "[parameters('appName')]",
              "image": "[parameters('initialContainerImage')]",
              "resources": {
                "cpu": 0.5,
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "HOST",
                  "value": "0.0.0.0"
                },
                {
                  "name": "PORT",
                  "value": "3978"
                },
                {
                  "name": "FOUNDRY_PROJECT_ENDPOINT",
                  "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName')), '2024-10-01').endpoint]"
                },
                {
                  "name": "FOUNDRY_MODEL",
                  "value": "[parameters('foundryModelName')]"
                },
                {
                  "name": "UAMI_CLIENT_ID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uamiName')), '2023-01-31').clientId]"
                },
                {
                  "name": "OAUTH_REDIRECT_URI",
                  "value": "[format('https://{0}.{1}/auth/callback', parameters('appName'), reference(resourceId('Microsoft.App/managedEnvironments', variables('caeName')), '2024-03-01').defaultDomain)]"
                },
                {
                  "name": "AUTH_FLOW_TTL_SECONDS",
                  "value": "600"
                },
                {
                  "name": "CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHORITY",
                  "value": "[format('https://login.microsoftonline.com/{0}', parameters('tenantId'))]"
                },
                {
                  "name": "CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE",
                  "value": "FederatedCredentials"
                },
                {
                  "name": "CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID",
                  "value": "[parameters('teamsBotClientId')]"
                },
                {
                  "name": "CONNECTIONS__SERVICE_CONNECTION__SETTINGS__FEDERATEDCLIENTID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uamiName')), '2023-01-31').clientId]"
                },
                {
                  "name": "CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID",
                  "value": "[parameters('tenantId')]"
                },
                {
                  "name": "CONNECTIONS__AGENTIC__SETTINGS__AUTHORITY",
                  "value": "[format('https://login.microsoftonline.com/{0}', parameters('tenantId'))]"
                },
                {
                  "name": "CONNECTIONS__AGENTIC__SETTINGS__AUTHTYPE",
                  "value": "FederatedCredentials"
                },
                {
                  "name": "CONNECTIONS__AGENTIC__SETTINGS__CLIENTID",
                  "value": "[parameters('blueprintClientId')]"
                },
                {
                  "name": "CONNECTIONS__AGENTIC__SETTINGS__FEDERATEDCLIENTID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uamiName')), '2023-01-31').clientId]"
                },
                {
                  "name": "CONNECTIONS__AGENTIC__SETTINGS__TENANTID",
                  "value": "[parameters('tenantId')]"
                },
                {
                  "name": "AGENTIC_INSTANCE_ID",
                  "value": "[parameters('agenticInstanceId')]"
                },
                {
                  "name": "CONNECTIONSMAP__0__SERVICEURL",
                  "value": "^https://(?:api.botframework.com|smba.trafficmanager.net)(?:/.*)?$"
                },
                {
                  "name": "CONNECTIONSMAP__0__CONNECTION",
                  "value": "SERVICE_CONNECTION"
                },
                {
                  "name": "CONNECTIONSMAP__1__SERVICEURL",
                  "value": "*"
                },
                {
                  "name": "CONNECTIONSMAP__1__CONNECTION",
                  "value": "AGENTIC"
                },
                {
                  "name": "CONNECTIONSMAP__1__AUDIENCE",
                  "value": "[parameters('blueprintClientId')]"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        }
      }
    }
  ],
  "outputs": {
    "acrName": {
      "type": "string",
      "value": "[variables('acrName')]"
    },
    "acrLoginServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer]"
    },
    "uamiName": {
      "type": "string",
      "value": "[variables('uamiName')]"
    },
    "uamiResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uamiName'))]"
    },
    "uamiClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uamiName')), '2023-01-31').clientId]"
    },
    "uamiPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uamiName')), '2023-01-31').principalId]"
    },
    "containerAppName": {
      "type": "string",
      "value": "[parameters('appName')]"
    },
    "containerAppFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('appName')), '2024-03-01').configuration.ingress.fqdn]"
    },
    "messagingEndpoint": {
      "type": "string",
      "value": "[format('https://{0}/api/messages', reference(resourceId('Microsoft.App/containerApps', parameters('appName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "oauthRedirectUri": {
      "type": "string",
      "value": "[format('https://{0}/auth/callback', reference(resourceId('Microsoft.App/containerApps', parameters('appName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "foundryAccountName": {
      "type": "string",
      "value": "[variables('foundryAccountName')]"
    },
    "foundryEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName')), '2024-10-01').endpoint]"
    }
  }
}
